{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/validate-branch.sh",
            "timeout": 10,
            "statusMessage": "Validating branch name..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lint-after-edit.sh",
            "timeout": 30,
            "statusMessage": "Linting edited file..."
          }
        ]
      }
    ]
  }
}
